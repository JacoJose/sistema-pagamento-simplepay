generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  document  String   @unique // CPF ou CNPJ
  apiKey    String   @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pixKeys PixKey[]
  charges Charge[]

  @@map("merchants")
}

model PixKey {
  id         String   @id @default(uuid())
  key        String   @unique
  type       String   // CPF, CNPJ, EMAIL, TELEFONE, CHAVE ALEATORIA
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  charges Charge[]

  @@map("pix_keys")
}

model Charge {
  id          String   @id @default(uuid())
  txid        String   @unique
  amount      Float
  status      String   @default("PENDING") // PENDING, PAID, CANCELLED
  description String?
  pixKeyId    String
  pixKey      PixKey   @relation(fields: [pixKeyId], references: [id], onDelete: Cascade)
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("charges")
}